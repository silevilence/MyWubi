    {"text": "±", "name": "正负号", "triggers": ["正负号", "数学符号", "正负"], "tags": ["数学符号"], "aliases": ["plusminus", "正负"], "order": 2, "sources": ["unicode-18", "mywubi-curated"]},
    {"text": "∓", "name": "负正号", "triggers": ["负正号", "数学符号", "负正"], "tags": ["数学符号"], "aliases": ["minusplus", "负正"], "order": 3, "sources": ["unicode-18", "mywubi-curated"]},
    {"text": "×", "name": "乘号", "triggers": ["乘号", "数学符号", "乘"], "tags": ["数学符号"], "aliases": ["times", "乘"], "order": 4, "sources": ["unicode-18", "mywubi-curated"]},
