    {"text": "｡∠(*^∇ﾟ)ﾉ⌒由 ｸﾘｽﾏｽﾌﾟﾚｾﾞﾝﾄ♪", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15789, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡∠(*゜∇゜*)☆メリークリスマス☆└*・ェ・*┘", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15790, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆ﾐ(o*・ω・)ﾉ Merry Christmas", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15791, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "∠(*゜∇゜*)☆メリークリスマス☆(*・ェ・*)＞｡", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15792, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡∠(o･_･)/[.○.]ﾄﾞﾘｷｬｽﾌﾟﾚｾﾞﾝﾄ♪", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15793, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "／⌒丶､ ○-⊂二二⊃ ( ⌒‐⌒ ) /つ🎁O しーＪ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15794, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(((*★**ﾌﾟﾚｾﾞﾝﾄ**★*)))ﾍ(^O^ﾍ*)三", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15795, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "*＜( ^O^)／□☆□＼(^O^ )＞* メリークリスマス！", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15796, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(((*★*プレゼント*★*)))ﾍ(･_･ﾍ).∠(o･_･)/由", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15797, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "プレゼント置イテクネ *＜(´・ω・)っ由　　|[(*´ｪ`)]|zZＺ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15798, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "*＜(*´∀`)ノ＜※+。:.゜Merry Christmas゜.:。+゜", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15799, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "o゜ｏ 。o／⌒⌒ヽ 。(二二二)〇 ｏ(｡◕◡◕｡)⌒) ┏━oo━┯━┓", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15800, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "C＜⌒⌒ヽ、 {i:i:i:i:i:i:i:i:} （ ´・ω・） （⌒ﾉO", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15801, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "C＜⌒⌒ヽ、 {i:i:i:i:i:i:i:i:} （ ´＞⩊＜） （🎁ﾉO", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15802, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "🧑🏻‍❤️‍💋‍🧑🏻💘恋人たちのクリスマス💘🧑🏻‍❤️‍💋‍🧑🏻", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15803, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "⁺⊹˚.⋆ o。／⌒⌒ヽ 🤍 。(二二二)〇 ᴍᴇʀʀʏ ｏ(𓈒ᖛ⩊ᖛ𓈒 )⌒) ᴄʜʀɪꜱᴍᴀꜱ◝✩ ┏━oo━┯━┓ 🤍", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15804, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*´﹃｀*) ケーキ食べたい", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15805, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*´∀｀*) サンタさん来た？", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15806, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𖢔 𝚇𝚖𝚊𝚜 ࿄ཽ·˖*", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15807, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆⌒(＞。≪) メリークリスマス！", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15808, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "((´∀｀*))家族でメリークリスマス", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15809, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "ฅ(｡ᵕ ω ᵕ｡ฅ) メリークリスマス", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15810, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*´･ω･)(･ω･`*) 二人でイブ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15811, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☃︎ ᴍᴇʀʀʏ ᴄʜʀɪsᴛᴍᴀs ☃︎", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15812, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(´｡• ω •｡`) ♡ 恋人とクリスマス", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15813, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "゜+.ﾟ(´▽`人)ﾟ+.゜ メリークリスマス", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15814, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(´･ω･`)人(´･ω･｀) みんなでメリクリ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15815, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆.。.:*(嬉´Д｀嬉).。.:*☆ メリクリ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15816, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆*:.｡.o(≧▽≦)o.｡.:*☆ メリクリ！", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15817, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡*:☆(´･ω･`人´･ω･`)｡:゜☆｡ メリクリ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15818, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𝕄𝕖𝕣𝕣𝕪 ℂ𝕙𝕣𝕚𝕤𝕥𝕞𝕒𝕤", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15819, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "⋆ᗰદ૨૨ʏ⋆ᐠ₍⁽˚⑅̆˚⁾₎ᐟ⋆ᘓમ૨ıડτന੨ડ⋆", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15820, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "‎ 𓂃꙳⋆ ᴍᴇʀʀʏ ᴄʜʀɪsᴛᴍᴀs ꙳⋆ 𓂃", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15821, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*´ω｀)o。゜+メリークリスマス+゜。o(´Ω｀*)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15822, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡∠(*ﾟ∇ﾟ*)☆ﾒﾘｰｸﾘｽﾏｽ☆(*･ｪ･*)＞｡", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15823, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "༼࿄ཽ༽༶･･ᗰદ૨૨ʏ ᘓમ૨ıડτന੨ડ･･༶༼࿄ཽ༽", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15824, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*^◇^*)。。oＯ(Merry Christmas☆彡)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15825, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "🎀*.🔔*…ᴍᴇʀʀʏ ᴄʜʀɪsᴛᴍᴀs…*🔔.*🎀", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15826, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "🛷𓂃꙳⋆ ᴍᴇʀʀʏ ᴄʜʀɪsᴛᴍᴀs 🦌﹆·🎅🏻", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15827, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "◕‿◕｡)ﾉ☆.。.:*・°☆.。.:*・°☆.。.:*・°☆", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15828, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*´∀｀)【☆･ﾟ:*ﾒﾘｨｸﾘｽﾏｽ*:ﾟ･☆】(´∀｀*)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15829, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "‪࿄ཽ·˖* 𝙼𝚎𝚛𝚛𝚢 𝚇𝚖𝚊𝚜 ࿄ཽ·˖*‬", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15830, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "🎄𝕄𝕖𝕣𝕣𝕪 𝕔𝕙𝕣𝕚𝕤𝕥𝕞𝕒𝕤🎄", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15831, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "ᔦᔧ✩𝕄𝕖𝕣𝕣𝕪 ℂ𝕙𝕣𝕚𝕤𝕥𝕞𝕒𝕤✩ᔦᔧ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15832, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "❅*॰ॱ ❅*◌⑅⃝*॰ॱ χ*ന੨ऽ╋⃞ྉ◌⑅⃝ ❅*॰ॱ ❅*॰", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15833, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(*´▽｀)v☆・゜:*☆ﾒ☆ﾘ☆ｸ☆ﾘ ☆・゜:*☆v(´▽｀=)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15834, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "🎄𝐌𝐞𝐫𝐫𝐲 𝐂𝐡𝐫𝐢𝐬𝐭𝐦𝐚𝐬 🎅🏼", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15835, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "·˖࿄ཽ 🫎 ‪𝙼𝚎𝚛𝚛𝚢 𝚇𝚖𝚊𝚜‬🎄 ࿄ཽ·˖", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15836, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𓂃꙳⋆ 𝙼𝚎𝚛𝚛𝚢 𝚇𝚖𝚊𝚜‬ 𓂃 𓍄 𓄽𓇬𓈒", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15837, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(´・ω・)ﾉ★*ﾟ*☆*ﾟ*めりーくりすます*ﾟ*☆*ﾟ*★ヽ(・ω・`)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15838, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "‪·̩͙꒰ঌ ℳ𝑒𝓇𝓇𝓎 𝒞𝒽𝓇𝒾𝓈𝓉𝓂𝒶𝓈 ໒꒱·̩͙", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15839, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "‎꒰🎄˗ˏˋ𝙼𝚎𝚛𝚛𝚢 𝙲𝚑𝚛𝚒𝚜𝚝𝚖𝚊𝚜´ˎ˗🎄꒱", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15840, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "‪·̩͙꒰ঌ🎄ℳ𝑒𝓇𝓇𝓎 𝒞𝒽𝓇𝒾𝓈𝓉𝓂𝒶𝓈🎄໒꒱·̩͙", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15841, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "$ﾟo｡oﾟﾊｯﾋﾟｰ(´･v｀o)ﾒﾘーｸﾘｽﾏｽ(o´v･｀)ﾊｯﾋﾟｰﾟo｡oﾟ$", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15842, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𓏸︎︎︎︎𓈒 𝙼𝚎𝚛𝚛𝚢 𝙲𝚑𝚛𝚒𝚜𝚝𝚖𝚊𝚜𓍄𓂃𓈒*", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15843, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "– ̗̀ 🤍🎄𝑀𝑒𝑟𝑟𝑦 𝐶ℎ𝑟𝑖𝑠𝑡𝑚𝑎𝑠🎄🤍 ̖́-", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15844, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "ﾒﾘｰｰｰｰｰ｡･：*：･ﾟ`★(o≧□≦)o☆.｡･：*：･ﾟ`ｸﾘｽﾏｰｰｰｰｰｽ!!!!!", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15845, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𐂂", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15846, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "ᔦᔧ✩", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15847, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𓃕ˊ˗", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15848, "sources": ["kaomojiya", "mywubi-zh"]},
