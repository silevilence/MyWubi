    {"text": "／＼ ＜＊彡＞ ／彡★＼", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15858, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "❅*⋆⍋*⋆*❅*⋆*⍋⋆*❅", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15859, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(人´∀｀)｡:*ﾟ お願い事", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15860, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "(-人-) 平和なクリスマスを", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15861, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "sɐɯʇsıɹɥɔ ʎɹɹǝɯ", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15862, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𖥍𓂂◌𖠿⋆𖠰𓐍𓂂𖠩", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15863, "sources": ["kaomojiya", "mywubi-zh"]},
