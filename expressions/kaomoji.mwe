    {"text": "ｺﾞﾁｿｳ(＊・ｖ・)【空】（´∀｀*）ｻﾏ♪", "name": "吃好了", "triggers": ["吃好了", "多谢款待"], "tags": ["吃好了", "多谢款待"], "aliases": [], "order": 31970, "sources": ["kaomojiya", "mywubi-zh"]},
