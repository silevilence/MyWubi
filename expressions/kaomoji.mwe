    {"text": "♪(´ε｀ )♪ ジングルベル♪", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15865, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "♪๓єггא ςђгเรt๓คร♪", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15866, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "▂╱╲▂ ╲ ╱ ▕╱╲▏ ╱ ◯╲", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15867, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆ ／＼ ／ ★∴＼ (人_人_人)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15868, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "⭐ 🎄🎄 🎄🔔🎄 🎄⛄️🎀🎄", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15869, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡ﾟ(ﾟ´ω`ﾟ)ﾟ｡ 願いが叶いますように", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15870, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆∴ 。∧☆ ★≪≫。* *≪☆≫ ≪☆★≫∵", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15871, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆ ╱╲*╱╲ ╱╳+▲╱ ╲ ╱╱ ◢◣+ ╳╲", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15872, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "★。＼｜／。★ Merry Xmas ★。／｜＼。★", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15873, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "🎄(*´꒳`*)🎄 メリクリ 🎄(*´꒳`*)🎄", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15874, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡*ﾟﾟ*｡ *｡ﾟﾟ｡*_ ﾟ*｡｡*(☆ﾌ｡*ﾟﾟ*｡", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15875, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "┈┈┈┈★┈┈┈┈ ┈┈┈★▇★┈┈┈ ┈┈★▇▇▇★┈┈", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15876, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𝕞𝕖𝕣𝕣𝕪 𝕔𝕙𝕣𝕚𝕤𝕥𝕞𝕒𝕤", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15877, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "M҉e҉r҉r҉y҉ C҉h҉r҉i҉s҉t҉m҉a҉s҉", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15878, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "*∧☆ ★≪≫。* *≪**≫ ≪****≫★ ☆∥* ■■", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15879, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "░M░e░r░r░y░ ░C░h░r░i░s░t░m░a░s░", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15880, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "━☆ﾟ.*･｡ﾟMerry Christmas ﾟ｡･*.ﾟ☆━", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15881, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "♫ ♪ ♫ (｡･ω･｡)ﾉ♫ ♪ Merry Christmas", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15882, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "･ﾟ✧*:･ﾟ✧ Merry Christmas ✧･ﾟ: *✧･ﾟ:", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15883, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "┊┊┊┊┊▂╱▏┊┊┊┊MERRY ┊┊┊┊┊╲┈╲┊┊CHRISTMAS", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15884, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "𝘔𝘌𝘙𝘙𝘠 ☆ 𝘟𝘔𝘈𝘚 ／＼ ／★∴＼ (人_人_人)", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15885, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": ".:*･ﾟ✧*:ﾟ✧ MERRY CHRISTMAS ✧ﾟ:*✧ﾟ:*･:.", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15886, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "｡*ﾟ+.*. C h rͫ iͤ sͬ tͬ m͗ a s +..｡*ﾟ+", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15887, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "✩ *:* *:*:* *:*:*:* *:*:*:*:*. *:*:*:*:*:*:", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15888, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "★*･. *★ *･ﾟ ﾟ／＼★｡*. ／ ＼ ￣∥￣ Merry Christmas", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15889, "sources": ["kaomojiya", "mywubi-zh"]},
    {"text": "☆*･. *☆ *･ﾟ ﾟ／＼☆｡*. ／ ＼ ￣■￣ Merry Christmas", "name": "圣诞", "triggers": ["圣诞", "圣诞快乐"], "tags": ["圣诞", "圣诞快乐"], "aliases": [], "order": 15890, "sources": ["kaomojiya", "mywubi-zh"]},
