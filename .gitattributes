# Keep generated dictionary checksums stable on Windows (core.autocrlf=true).
/tables/wubi86.dict text eol=lf
/tables/pinyin.dict text eol=lf
/tables/english.dict text eol=lf
/tables/sources.json text eol=lf
/tables/licenses/*.txt text eol=lf

# Preserve the exact bytes of Sandbox acceptance evidence and its SHA-256 hashes.
/docs/validation/cp10/*.toml -text
/docs/validation/cp10/*.dict -text
/docs/validation/cp10/engine.log -text

# Keep Android launchers portable.
/android/gradlew text eol=lf
/android/gradlew.bat text eol=crlf

# ONNX protobuf graphs must never undergo Windows line-ending conversion.
*.onnx binary

# Reproducible bundled prediction lexicon.
/core_engine/src/assistance/*.tsv text eol=lf

# Keep upstream notices byte-for-byte, including their original whitespace.
/model_input/licenses/*.txt -text -whitespace
/model_input/licenses/sources.json text eol=lf

# Frozen generation evaluation hashes cover the original input/evidence bytes.
/model_input/evaluation/generation-policy.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/model_input/evaluation/generation-dev.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/model_input/evaluation/generation-acceptance.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
/docs/validation/mi26-*.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
